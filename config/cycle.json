{
  "schemaVersion": 1,
  "firstTurnCeilings": {
    "baselineTokens": 10000,
    "dispatcher": 22000,
    "project-lead": 30000,
    "ic": 35000,
    "sentinel": 22000,
    "principal": 30000
  },
  "cap": {
    "exemptNamePrefixes": ["pe-"]
  },
  "triage": {
    "markerLabel": "triage-proposed",
    "triageLabels": ["needs-triage", "question"],
    "routingLabels": ["ready-for-human", "needs-info", "wontfix", "spec"],
    "maxProposalsPerTurn": 5,
    "windowDays": 14,
    "graduation": { "minProposals": 30, "minDays": 14, "minUnchangedRatio": 0.9 }
  },
  "ic": {
    "warnTokens": 50000,
    "escalateTokens": 350000
  },
  "frontierWake": {
    "cooldownMinutes": 60,
    "sources": ["frontier", "outbox"]
  },
  "budgets": {
    "baselineControlPlaneFreshPerCompletedUnit": 201505,
    "controlPlaneFreshReduction": 0.7,
    "projectLeadFreshPerMergedPr": 25000,
    "icJobTokensMedian": 60000
  },
  "review": {
    "trivialMaxChangedLines": 25,
    "trivialMaxFiles": 3,
    "patternExcludePaths": ["**/*.md", "**/*.txt", "docs/**"]
  },
  "rotation": {
    "dispatcher": { "maxAgeHours": 24 },
    "project-lead": { "maxAgeHours": 24, "maxMerges": 5, "maxJobTokens": 250000 },
    "principal": { "maxAgeHours": 24, "maxJobTokens": 250000 }
  },
  "watchdog": {
    "staleMinutes": 45
  },
  "supervisor": {
    "parityHours": 48,
    "pairWindowMinutes": 10,
    "maxGapMinutes": 35,
    "tickMinutes": 15,
    "pageKinds": ["stray", "cap-exceeded", "ic-vanished", "pr-lookup-failed", "branch-diverged"]
  },
  "assignment": {
    "parityEvaluations": 20,
    "parityDistinctFrontiers": 5,
    "parityHours": 48
  }
}
